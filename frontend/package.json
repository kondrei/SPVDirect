{
  "name": "spvdirect-frontend",
  "version": "0.0.1",
  "description": "SPVDirect web app: ANAF SPV accountant portal (React)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:sonar": "eslint --max-warnings 0 src",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
