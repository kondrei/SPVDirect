# Where Vite's dev server forwards /api/* (the NestJS API). Default: https://localhost:3000
API_PROXY_TARGET=https://localhost:3000
# Base URL the app calls. Keep /api in dev (proxied). In production set it to the API's
# public URL, and serve the app on the same site as the API so the session cookie is sent.
VITE_API_URL=/api
# Google reCAPTCHA v3 site key (public). The matching secret is RECAPTCHA_SECRET_KEY in backend/.env
VITE_RECAPTCHA_SITE_KEY=
