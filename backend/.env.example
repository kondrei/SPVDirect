# --- Server ---
NODE_ENV=development
PORT=3000
# Serve HTTPS directly (ANAF only redirects to https://). Generate with: npm run cert:dev
# Remove both lines to serve plain HTTP (production, behind Azure TLS).
HTTPS_KEY_FILE=certs/localhost-key.pem
HTTPS_CERT_FILE=certs/localhost-cert.pem
# Public URL of this API (used to build authorization links)
API_URL=https://localhost:3000
# React app (CORS origin + post-login redirects)
FRONTEND_URL=http://localhost:5173

# --- Database (Supabase) ---
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432, works over IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Secrets ---
# Signs SPVDirect's own session cookie. At least 32 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32plus-chars
# Encrypts ANAF tokens at rest. Exactly 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- ANAF OAuth (from SPV -> "Editare profil Oauth") ---
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
# Must match the Callback URL registered at ANAF byte for byte
ANAF_REDIRECT_URI=https://localhost:3000/anaf/callback
ANAF_AUTH_ENDPOINT=https://logincert.anaf.ro/anaf-oauth2/v1/authorize
ANAF_TOKEN_ENDPOINT=https://logincert.anaf.ro/anaf-oauth2/v1/token
ANAF_REVOKE_ENDPOINT=https://logincert.anaf.ro/anaf-oauth2/v1/revoke
ANAF_API_ENDPOINT=https://api.anaf.ro
# test -> api.anaf.ro/test/...   prod -> api.anaf.ro/prod/...
ANAF_ENV=test
# SPV web services (listaMesaje, descarcare, cerere)
ANAF_SPV_ENDPOINT=https://webserviced.anaf.ro/SPVWS2/rest

# Public VAT registry (webservicesp.anaf.ro, no OAuth): fills in company data from the CUI. Max 1 request/second.
ANAF_TVA_ENDPOINT=https://webservicesp.anaf.ro/api/PlatitorTvaRest/v9/tva

# Where SPV message PDFs are kept: database (bytea column, default) or supabase (Supabase Storage).
# Free plan: 500 MB database, 1 GB storage. With supabase, the nightly job also moves PDFs already in the database to Storage.
SPV_STORAGE=database
# Needed only when SPV_STORAGE=supabase. The service key is a server-side secret: never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Private bucket, created automatically on first use
SUPABASE_SPV_BUCKET=spv-messages

# data.gov.ro CKAN API: ONRC CAEN nomenclator (cached 24 h) and MF payer data for the vector fiscal
DATA_GOV_RO_API_URL=https://data.gov.ro/api/3/action

# --- Registration ---
# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin, type "Score based (v3)").
# The site key goes in frontend/.env as VITE_RECAPTCHA_SITE_KEY; add localhost to the domains for dev.
RECAPTCHA_SECRET_KEY=
# Scores go from 0.0 (bot) to 1.0 (human); lower scores are rejected
RECAPTCHA_MIN_SCORE=0.5
# New accounts stay pending until this address approves them from the emailed link
ADMIN_EMAIL=admin@example.com

# --- Email (SMTP) ---
MAIL_FROM="SPVDirect <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false upgrades with STARTTLS when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
